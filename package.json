{
  "name": "superheads",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-export.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "assets:curate": "node scripts/curate-assets.mjs",
    "serve": "serve out -l 3100",
    "deploy:preview": "bash scripts/deploy.sh preview",
    "deploy:apply": "bash scripts/deploy.sh apply"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xmldom/xmldom": "^0.8.11",
    "serve": "^14.2.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
